# Copie para .env.local (para rodar no seu PC) ou cadastre na Vercel em Settings > Environment Variables.
# Os valores ficam no Supabase em Project Settings > API.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Opcional: trava o site numa empresa (elyplast, gppharma). Vazio = pergunta ao abrir.
VITE_EMPRESA=
